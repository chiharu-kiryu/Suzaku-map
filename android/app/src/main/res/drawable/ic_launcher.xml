<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#DCE7F5" />
        </shape>
    </item>
    <item android:insetLeft="10dp" android:insetTop="10dp" android:insetRight="10dp" android:insetBottom="10dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#79BFFF"
                android:startColor="#B8E0FF" />
        </shape>
    </item>
    <item android:gravity="center" android:width="28dp" android:height="28dp">
        <shape android:shape="oval">
            <solid android:color="#F05B5B" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp">

    <FrameLayout
        android:id="@+id/compactBubbleShell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end">

        <ImageButton
            android:id="@+id/compactBubbleButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end"
            android:background="@drawable/compact_bubble_bg"
            android:contentDescription="@string/virtual_keyboard"
            android:padding="9dp"
            android:src="@drawable/compact_bubble_suzaku" />

        <View
            android:id="@+id/compactBubbleDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/compact_bubble_dot"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/imePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#DCE6F1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/composePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gboard_compose_surface"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="@string/compose_placeholder"
            android:textColor="#173B63"
            android:textSize="17sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/gboard_candidate_bar_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/candidateStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/toolKeyboard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/tool_button_bg"
                android:contentDescription="@string/virtual_keyboard"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_edit" />

            <ImageButton
                android:id="@+id/toolVoice"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/tool_button_bg"
                android:contentDescription="@string/voice_input"
                android:padding="9dp"
                android:src="@android:drawable/ic_btn_speak_now" />

            <ImageButton
                android:id="@+id/toolHandwrite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/tool_button_bg"
                android:contentDescription="@string/handwriting_input"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_edit" />

            <ImageButton
                android:id="@+id/toolSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/tool_button_bg"
                android:contentDescription="@string/settings"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_manage" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/toolCollapse"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/tool_button_bg"
                android:contentDescription="@string/collapse_input"
                android:padding="9dp"
                android:src="@android:drawable/ic_media_previous" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/drawerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/gboard_drawer_bg"
            android:padding="12dp">

            <LinearLayout
                android:id="@+id/keyboardDrawer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/keyboardDrawerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keyboard_drawer_title"
                    android:textColor="#5A6E86"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/keyboardRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/voiceDrawer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/voice_drawer_title"
                        android:textColor="#173B63"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/voiceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_status_idle"
                        android:textColor="#536A86"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/voiceLevelRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/voiceLevelBar1"
                        android:layout_width="8dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="6dp"
                        android:alpha="0.45"
                        android:background="@drawable/gboard_action_button_bg" />

                    <View
                        android:id="@+id/voiceLevelBar2"
                        android:layout_width="8dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        android:alpha="0.55"
                        android:background="@drawable/gboard_action_button_bg" />

                    <View
                        android:id="@+id/voiceLevelBar3"
                        android:layout_width="8dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:alpha="0.45"
                        android:background="@drawable/gboard_action_button_bg" />

                    <View
                        android:id="@+id/voiceLevelBar4"
                        android:layout_width="8dp"
                        android:layout_height="20dp"
                        android:alpha="0.4"
                        android:background="@drawable/gboard_action_button_bg" />
                </LinearLayout>

                <EditText
                    android:id="@+id/voiceTranscriptInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/gboard_compose_surface"
                    android:gravity="top|start"
                    android:hint="@string/voice_sample_hint"
                    android:minHeight="88dp"
                    android:padding="12dp"
                    android:textColor="#173B63"
                    android:textColorHint="#7A8FA8"
                    tools:text="ni hao voice sample" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/voiceListenButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_listen" />

                    <Button
                        android:id="@+id/voiceUseTranscriptButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/voice_use_transcript" />

                    <Button
                        android:id="@+id/voiceCommitButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/voice_commit_selected" />

                    <Button
                        android:id="@+id/voiceClearButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/voice_clear" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/handwriteDrawer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/handwrite_drawer_title"
                        android:textColor="#173B63"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/handwriteStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/handwrite_status_idle"
                        android:textColor="#536A86"
                        android:textSize="12sp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/handwriteCandidateStrip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <dev.suzaku.android.ime.SuzakuHandwriteCanvasView
                    android:id="@+id/handwriteCanvas"
                    android:layout_width="match_parent"
                    android:layout_height="248dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/gboard_compose_surface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/handwriteApplyButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/handwrite_use_seed" />

                    <Button
                        android:id="@+id/handwriteClearButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/handwrite_clear" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/hostStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/host_status_ready"
            android:textColor="#60758D"
            android:textSize="12sp"
            tools:text="Android IME host connected" />
    </LinearLayout>

</LinearLayout>
